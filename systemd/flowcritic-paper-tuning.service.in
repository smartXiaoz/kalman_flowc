[Unit]
Description=FlowCritic paper tuning continuous supervisor
Wants=network-online.target
After=network-online.target
ConditionPathExists=@ROOT@/scripts/continuous_tune.py

[Service]
Type=simple
WorkingDirectory=@ROOT@
Environment=PYTHONUNBUFFERED=1
Environment=FLOWCRITIC_CONDA_EXE=@CONDA_EXE@
Environment=FLOWCRITIC_PYTHON=@PYTHON_EXE@
Environment=FLOWCRITIC_CONTINUE_AFTER_STAGNATION=1
EnvironmentFile=-%h/.config/flowcritic-paper-tuning.env
ExecStart=@ROOT@/scripts/run_continuous_tune_service.sh
StandardOutput=append:@ROOT@/state/continuous_tune.supervisor.log
StandardError=append:@ROOT@/state/continuous_tune.supervisor.log
SyslogIdentifier=flowcritic-paper-tuning
Restart=on-failure
RestartSec=30s
TimeoutStopSec=30s
KillMode=process

[Install]
WantedBy=default.target
