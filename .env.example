# Optional planner configuration. Never commit a real .env file or API key.
OPENAI_API_KEY=
# Use a private OpenAI-compatible gateway when the selected model is hosted there.
FLOWCRITIC_LLM_BASE_URL=https://api.openai.com/v1
CODEX_BIN=codex

# Optional continuous-loop settings.
FLOWCRITIC_CONDA_ENV=RLS
FLOWCRITIC_MAX_ROUNDS=12
FLOWCRITIC_CONTINUE_AFTER_STAGNATION=1
FLOWCRITIC_PLANNER_RETRY_DELAY_SEC=300
FLOWCRITIC_ROUND_RETRY_DELAY_SEC=120
