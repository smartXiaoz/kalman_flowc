{
  "schema_version": 1,
  "environments": [
    "FrankaCubeStack",
    "Quadcopter",
    "FrankaCabinet",
    "BallBalance",
    "ShadowHandOpenAI_FF",
    "Anymal",
    "Ant",
    "AllegroHand",
    "Humanoid",
    "AllegroKuka",
    "AllegroKukaTwoArmsLSTM",
    "ShadowHand"
  ],
  "seeds": [
    1,
    2,
    3,
    4
  ],
  "architecture_constraints": {
    "model_L": true,
    "hidden_size": 512,
    "note": "Preserve the current Model_L implementation (five 512-unit hidden Linear layers); do not reconcile it to the paper's [512]x4 text."
  },
  "fixed_parameters": {
    "num_envs": 1024,
    "num_steps": 16,
    "learning_rate": 0.0005,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "num_minibatches": 2,
    "minibatch_size": 8192,
    "update_epochs": 4,
    "norm_adv": true,
    "clip_coef": 0.2,
    "max_grad_norm": 1,
    "k_repeat": 10,
    "n_remove": 1,
    "diff_step": 5,
    "exp_alpha": 0.1,
    "velocity_clip_delta": 0.2
  },
  "fixed_implementation": {
    "optimizer": "Adam",
    "adam_eps": 0.00001,
    "model_L": true,
    "rollout_mean_mode": "remove_max"
  },
  "search_precision_policy": {
    "max_decimal_places": 3,
    "required_increment": 0.005,
    "preferred_increments": [0.01, 0.005],
    "exempt_parameters": ["reward_scaler"],
    "fixed_non_search_exceptions": {
      "learning_rate": 0.0005,
      "adam_eps": 0.00001
    },
    "binary_subdivision_below_grid_forbidden": true,
    "legacy_incumbents_require_revalidation": true
  },
  "parameter_families": {
    "distribution": ["prior_std", "cov_floor", "flow_sigma"],
    "normalization": ["target_norm", "target_norm_update", "target_norm_ema_tau"],
    "weight_stability": ["cov_weight_clip", "ess_floor", "alpha_warmup_updates"],
    "loss_balance": ["reward_scaler", "acf_coef", "vf_coef"],
    "critic_update": ["old_critic_update", "old_critic_ema_tau"],
    "bootstrap": ["bootstrap_mean_mode"]
  },
  "budgets": {
    "Anymal": 80000000,
    "FrankaCabinet": 80000000,
    "default": 100000000
  },
  "derived_runtime_parameters": {
    "batch_size": "num_envs * num_steps",
    "minibatch_size": "batch_size // num_minibatches",
    "num_iterations": "total_timesteps // batch_size",
    "effective_total_timesteps": "num_iterations * batch_size",
    "effective_80000000": 79986688,
    "effective_100000000": 99991552
  },
  "search_stages": {
    "stage_1": {
      "prior_std": {
        "type": "number",
        "minimum": 0.1,
        "maximum": 4
      },
      "target_norm": {
        "type": "string",
        "enum": [
          "none",
          "running_return"
        ]
      },
      "cov_floor": {
        "type": "number",
        "minimum": 0,
        "maximum": 10
      },
      "reward_scaler": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 10
      },
      "acf_coef": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 10
      },
      "vf_coef": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 10
      },
      "flow_sigma": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "stage_2": {
      "target_norm_update": {
        "type": "string",
        "enum": [
          "cumulative",
          "running",
          "ema"
        ],
        "note": "The trainer accepts running as an alias of cumulative; history deduplication should canonicalize the alias."
      },
      "target_norm_ema_tau": {
        "type": "number",
        "minimum": 0,
        "maximum": 0.9999
      },
      "cov_weight_clip": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
              "items": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0.0,
                "maximum": 1.0
              }
          }
        ],
        "invariant": "non-null minimum must be <= non-null maximum"
      },
      "ess_floor": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "alpha_warmup_updates": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100000
      }
    },
    "stage_3": {
      "old_critic_update": {
        "type": "string",
        "enum": [
          "hard",
          "ema"
        ]
      },
      "old_critic_ema_tau": {
        "type": "number",
        "minimum": 0,
        "maximum": 0.99999
      },
      "bootstrap_mean_mode": {
        "type": "string",
        "enum": [
          "normal",
          "remove_max",
          "remove_max_min"
        ]
      }
    }
  },
  "forbidden_overrides": [
    "rollout_mean_mode",
    "mean_mode",
    "k_repeat",
    "n_remove",
    "diff_step",
    "exp_alpha",
    "velocity_clip_delta",
    "gamma",
    "learning_rate",
    "num_envs",
    "num_steps",
    "update_epochs",
    "clip_coef",
    "num_minibatches",
    "minibatch_size",
    "gae_lambda",
    "norm_adv",
    "max_grad_norm",
    "model_L",
    "hidden_size",
    "seed",
    "env_id",
    "total_timesteps"
  ],
  "dead_or_unused_keys": [
    "predict_epsilon",
    "noise_ratio",
    "vloss_coef",
    "weight"
  ],
  "plan_limits": {
    "max_variants_per_environment": 2,
    "max_jobs_per_round": 48,
    "require_complete_seed_cohort": true
  },
  "stage_4_unification": {
    "optional": true,
    "order": [
      "one_global_shared_configuration",
      "two_shared_environment_clusters",
      "retain_per_environment_configuration"
    ],
    "shared_parameters": [
      "prior_std",
      "target_norm",
      "cov_floor",
      "target_norm_update",
      "target_norm_ema_tau",
      "cov_weight_clip",
      "ess_floor",
      "alpha_warmup_updates",
      "old_critic_update",
      "old_critic_ema_tau",
      "bootstrap_mean_mode"
    ],
    "environment_specific_by_default": [
      "reward_scaler",
      "acf_coef",
      "vf_coef",
      "flow_sigma"
    ],
    "acceptance_gates": {
      "complete_seeds": [1, 2, 3, 4],
      "paper_ratio_minimum": 0.9,
      "incumbent_retention_minimum": 0.95,
      "allow_integrity_failures": false
    }
  }
}
